# Copy to .signing.env and fill in. .signing.env is gitignored.
#
# The notarytool profile stores the Apple ID + app-specific password in the
# macOS keychain, so no secret is ever written to disk here. Create it once:
#
#   xcrun notarytool store-credentials "<profile-name>" \
#     --apple-id <your-apple-id> \
#     --team-id <your-team-id> \
#     --password <app-specific-password>
#
PROMPTBAR_SIGN_IDENTITY="Developer ID Application: Your Org (TEAMID)"
PROMPTBAR_TEAM_ID="TEAMID"
PROMPTBAR_NOTARY_PROFILE="promptbar-notary"
